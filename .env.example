# Public origin. Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.sanctumsquare.com

# --- Enquiry form delivery -------------------------------------------------
# Set ONE of the two options below. Without either, the contact form tells the
# visitor it is not connected rather than silently dropping their enquiry.

# 1. POST the enquiry as JSON to any endpoint (Zapier, Make, n8n, a CRM).
# ENQUIRY_WEBHOOK_URL=

# 2. Or send it as email through Resend.
#    ENQUIRY_FROM_EMAIL must be on a domain verified in your Resend account.
# RESEND_API_KEY=
# ENQUIRY_FROM_EMAIL=website@sanctumsquare.com
# ENQUIRY_TO_EMAIL=info@sanctumsquare.com
